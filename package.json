{
  "name": "wvcs-school-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.js test/forecast/*.test.ts test/forecast/*.test.js",
    "preview": "vite preview",
    "gmail:token": "node scripts/google-oauth-refresh-token.mjs",
    "scheduler:update": "git subtree pull --prefix=vendor/school-scheduler https://github.com/ChristianInfluence/school-scheduler.git main --squash",
    "student-evaluation:update": "git subtree pull --prefix=vendor/student-evaluation https://github.com/ChristianInfluence/student-evaluation.git main --squash",
    "test:forecast": "node --import tsx --test test/forecast/*.test.ts test/forecast/*.test.js",
    "typecheck:forecast": "tsc --noEmit -p tsconfig.forecast.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "exceljs": "4.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "3.8.0",
    "tailwindcss": "^4.2.4",
    "zod": "3.25.76",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "supabase": "^2.98.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "^8.0.10"
  }
}
